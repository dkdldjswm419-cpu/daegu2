# 이 파일을 .env.local로 복사한 뒤 값을 채운다 (.env.local은 공유·커밋 금지)
# Supabase 대시보드 → Project Settings → API (Data API) 에서 확인
# session pooler / postgres:// 연결 문자열은 쓰지 않는다

# 프로젝트 URL
SUPABASE_URL=https://xxxxxxxx.supabase.co
# anon (public) 키 — 조회에 사용
SUPABASE_ANON_KEY=여기에_anon_키
# service_role 키 — 추가·삭제에 사용 (RLS 우회, 노출 주의)
SUPABASE_SERVICE_ROLE_KEY=여기에_service_role_키
# 관리자 비밀번호 — 페이지에서 추가·삭제할 때 입력. 비우면 추가·삭제가 막힘
ADMIN_PASSWORD=여기에_긴_비밀번호

# 선택: 페이지 포트 (기본 3030)
PORT=3030
